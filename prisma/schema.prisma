generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key       String   @id
  value     String
  type      String   @default("string")
  label     String
  category  String   @default("general")
  min       String?
  max       String?
  help      String?
  updatedAt DateTime @updatedAt
}

model AdvertiserPlan {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  viewsIncluded Int
  priceKnight   Float
  viewSeconds   Int
  feedPriority  Int      @default(100)
  diamondCount  Int      @default(1)
  badgeColor    String   @default("amber")
  description   String
  isActive      Boolean  @default(true)
  isPermanent   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ads           Ad[]
}

model SideAd {
  id        String   @id @default(cuid())
  position  String
  title     String
  content   String
  link      String
  imageUrl  String?
  mediaType String   @default("image")
  width     Int      @default(220)
  height    Int      @default(120)
  bgColor   String   @default("slate")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VisitorPlan {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  costKnight      Float    @default(0)
  durationDays    Int      @default(15)
  multiplier      Float    @default(1.0)
  dailyViewsLimit Int      @default(0)
  feedPriority    Int      @default(100)
  badgeColor      String   @default("slate")
  description     String
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TreasuryAccount {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  balance     Float    @default(0)
  color       String   @default("amber")
  updatedAt   DateTime @updatedAt
}

model Ad {
  id               String         @id @default(cuid())
  title            String
  content          String
  link             String
  advertiser       String
  planId           String
  viewsUsed        Int            @default(0)
  status           String         @default("active")
  isAdministrative Boolean        @default(false)
  imageUrl         String?
  mediaType        String         @default("image")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  plan             AdvertiserPlan @relation(fields: [planId], references: [id])
  ratings          AdRating[]
}

model AdRating {
  id        String   @id @default(cuid())
  adId      String
  userLabel String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, userLabel])
}

model AdminCredential {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  secretCode   String
  email        String   @default("admin@knight.demo")
  mfaLabel     String   @default("Knight Admin MFA")
  updatedAt    DateTime @updatedAt
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  name                  String
  role                  String            @default("visitante")
  referralCode          String            @unique
  referredByCode        String?
  balanceKnight         Float             @default(0)
  createdAt             DateTime          @default(now())
  earningsFromReferrals ReferralEarning[] @relation("earner")
  earningsAsReferrer    ReferralEarning[] @relation("source")
}

model ReferralEarning {
  id           String   @id @default(cuid())
  earnerUserId String
  sourceUserId String
  amountKnight Float
  level        Int
  reason       String
  createdAt    DateTime @default(now())
  earner       User     @relation("earner", fields: [earnerUserId], references: [id])
  source       User     @relation("source", fields: [sourceUserId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  detail    String
  before    String?
  after     String?
  ipAddress String?
  createdAt DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Visit {
  id        String   @id
  date      String   @unique
  count     Int      @default(0)
  uniqueIps Int      @default(0)
  updatedAt DateTime
}
